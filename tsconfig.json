{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "lib": [ "ES2022", "DOM", "DOM.Iterable" ],
        "types": [ "bun", "vite/client" ],

        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,

        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true
    },

    "include": [
        "/web/src/**/*.ts",
        "web/src/**/*.d.ts",
        "web/src/**/*.vue",
        "vite.config.ts"
    ]
}
